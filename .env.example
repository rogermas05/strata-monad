# Local-only execution. No secrets are required for the local fork.
RPC_URL=http://127.0.0.1:8546
# Optional backend-only read endpoint. Never copied into manifests or frontend code.
SERVICE_RPC_URL=
# 1 disables unlocked transactions and local workers, including on chain 31337.
API_READ_ONLY=0
FORK_RPC_URL=https://testnet-rpc.monad.xyz
VENUE_MODE=kuru
API_PORT=3001
WEB_PORT=5173

# Optional authenticated oracle integration checks; .env is ignored by git.
# Never put API keys in frontend variables, browser code or deployment manifests.
HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
# Optional independent backup endpoint; omitted key uses PYTH_API_KEY.
HERMES_BACKUP_URL=
PYTH_BACKUP_API_KEY=
# Feeds reused from a contract where another party already pushes signed updates,
# instead of Hermes (e.g. MON on Monad testnet). See docs/multi-asset-oracles.md.
PYTH_PUSHED_FEEDS=
PYTH_PUSHED_RPC_URL=
PYTH_PUSHED_CONTRACT=
# Documented candidates are listed in docs/oracle-operations.md.
# Set these only after checking the intended chain, feed and verifier.
PYTH_VERIFIER=
PYTH_FEED_ID=
PYTH_CHECK_TIMESTAMP=
CHECK_ACCOUNT=

# Public testnet signer keys (backend only; keep in the ignored .env, chmod 600).
# Not read by any service until the managed signer is wired into public mode.
STRATA_DEPLOYER_PRIVATE_KEY=
STRATA_DEPLOYER_ADDRESS=
STRATA_MAKER_PRIVATE_KEY=
STRATA_MAKER_ADDRESS=
